# TuniFlow Docker environment example
# Copy to .env and replace CHANGE_ME values locally. Never commit .env.

POSTGRES_DB=einvoicing_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=einvoicing_db;Username=postgres;Password=CHANGE_ME_POSTGRES_PASSWORD
Jwt__Secret=CHANGE_ME_DOCKER_JWT_SECRET_MIN_32_CHARS_123456
Jwt__Issuer=Einvoicing.Api
Jwt__Audience=Einvoicing.Frontend
SuperAdmin__Password=CHANGE_ME_SUPERADMIN_PASSWORD

OcrService__BaseUrl=http://ocr-api:8000
OcrService__AutoStart=false
OcrService__TimeoutSeconds=360
MachineLearning__ApiKey=CHANGE_ME_INTERNAL_ML_API_KEY_MIN_32_CHARS

Cors__AllowedOrigins__0=http://localhost
Cors__AllowedOrigins__1=http://localhost:4200
Cors__AllowedOrigins__2=http://127.0.0.1
Cors__AllowedOrigins__3=http://127.0.0.1:4200
Cors__AllowedOrigins__4=https://invoice.ey.tn

Email__Utilisateur=
Email__MotDePasse=
Sms__Provider=Twilio
Sms__AccountSid=
Sms__AuthToken=
Sms__From=
Uploads__Root=/app/uploads
